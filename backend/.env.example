# ─────────────────────────────────────────────────────────────────────────────
# RWA Marketplace — Backend Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Admin ─────────────────────────────────────────────────────────────────────
# Admin API key for write operations — generate with:
#   openssl rand -hex 32
ADMIN_API_KEY=change-me-to-a-random-secret-key

# ── Data storage ──────────────────────────────────────────────────────────────
# Path to the JSON flat-file store (relative to backend directory)
DATA_FILE=data.json

# ── Redis cache (optional) ────────────────────────────────────────────────────
# When unset the backend falls back to an in-process no-op cache.
# Use rediss:// (note the double-s) as the URL scheme for TLS connections.
#
#   Plain TCP:    redis://localhost:6379
#   TLS:          rediss://localhost:6380
#
# REDIS_URL=redis://localhost:6379
# CACHE_TTL_SECONDS=60

# ── Redis TLS / mTLS ──────────────────────────────────────────────────────────
# Set REDIS_TLS=true to enable TLS for the Redis connection.
# The URL scheme should also change to rediss:// when using TLS.
#
# REDIS_TLS=true

# Path to the CA certificate used to verify the Redis server's certificate.
# Required when using a self-signed CA (local dev / private PKI).
# In production with a trusted CA (Let's Encrypt, etc.) this can be omitted.
#
# REDIS_TLS_CA=/etc/ssl/rwa/ca.crt

# Client certificate and key for mutual TLS (mTLS).
# Required only when the Redis server enforces client authentication
# (redis.conf: tls-auth-clients yes).
#
# REDIS_TLS_CERT=/etc/ssl/rwa/client.crt
# REDIS_TLS_KEY=/etc/ssl/rwa/client.key

# Whether to reject Redis connections whose certificate cannot be validated.
# Always keep this true in production to prevent MITM attacks.
# Set to false ONLY for local development with self-signed certificates.
#
# REDIS_TLS_REJECT_UNAUTHORIZED=true

# ── Nginx / HTTPS ─────────────────────────────────────────────────────────────
# Nginx reads its certificate paths directly from its own config (nginx.conf).
# The paths below are here for documentation purposes and for the cert
# generation script (scripts/generate-certs.sh).
#
# TLS_CERT_DIR=/etc/ssl/rwa          # directory that holds all certificates
# TLS_NGINX_CERT=/etc/ssl/rwa/nginx.crt
# TLS_NGINX_KEY=/etc/ssl/rwa/nginx.key
# TLS_CA_CERT=/etc/ssl/rwa/ca.crt

# ── Data consistency checks ───────────────────────────────────────────────────
# Enable periodic consistency checks between cache, database, and blockchain.
# When enabled, the system runs checks on a schedule and can optionally
# auto-repair issues (clearing stale cache, flagging mismatches).
#
# CONSISTENCY_CHECK_ENABLED=false
# CONSISTENCY_CHECK_INTERVAL_MINUTES=60
# CONSISTENCY_AUTO_REPAIR=false
# CONSISTENCY_LOG_DIR=/var/log/rwa-marketplace/consistency

# ── Observability ─────────────────────────────────────────────────────────────
# Sentry error tracking — disabled when unset
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1

# Logging
# LOG_LEVEL=info
# NODE_ENV=development
