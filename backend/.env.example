# Server configuration
PORT=3001

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Admin API key for write operations (generate a strong random key)
ADMIN_API_KEY=change-me-to-a-random-secret-key

# Admin email for billing notifications
# ADMIN_EMAIL=admin@example.com

# Data file path (relative to backend directory)
DATA_FILE=data.json

# Redis configuration (optional — falls back to in-memory)
# REDIS_URL=redis://localhost:6379
# CACHE_TTL_SECONDS=60

# Sentry error tracking (optional — error tracking is disabled when unset)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1

# Logging
# LOG_LEVEL=info
# NODE_ENV=development

# ── Rate Limiting ──────────────────────────────────────────────────────────────
# Custom tier overrides (JSON). Defaults: free (100/min, burst 20), premium (1000/min, burst 200), enterprise (10000/min, burst 2000)
# RATE_LIMIT_TIERS={"free":{"maxRequests":200,"burstCapacity":30}}

# Rate limit analytics (default: true)
# RATE_LIMIT_ANALYTICS_ENABLED=true
# RATE_LIMIT_ANALYTICS_MAX_LOG=10000

# ── Anomaly Detection ──────────────────────────────────────────────────────────
# Enable ML-based anomaly detection (default: true)
# ANOMALY_DETECTION_ENABLED=true
# ANOMALY_BURST_THRESHOLD=50
# ANOMALY_TIME_WINDOW_MS=10000
# ANOMALY_CONFIDENCE_THRESHOLD=0.7

# ── Geographic Rate Limiting ───────────────────────────────────────────────────
# Enable geographic rate limiting (default: true)
# GEO_LIMITING_ENABLED=true
# Comma-separated list of blocked country codes (ISO 3166-1 alpha-2)
# GEO_BLOCKED_COUNTRIES=
# Comma-separated list of restricted countries with hourly limits (e.g. "US:500,GB:300")
# GEO_RESTRICTED_COUNTRIES=

# ── Billing Integration ────────────────────────────────────────────────────────
# Enable billing integration (default: true)
# BILLING_INTEGRATION_ENABLED=true
# Stripe secret key (optional — billing runs in usage-tracking mode without it)
# STRIPE_SECRET_KEY=
# Stripe price IDs per tier (optional)
# STRIPE_PRICE_FREE=
# STRIPE_PRICE_PREMIUM=
# STRIPE_PRICE_ENTERPRISE=
