# ── Required ──────────────────────────────────────────────────────────────────

# Comma-separated list of origins allowed by CORS.
# Example for production: https://your-frontend.onrender.com
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Optional (safe defaults shown) ────────────────────────────────────────────

# Port the HTTP server listens on. Must be 1–65535.
# PORT=3001

# Path to the JSON data file, relative to the backend directory.
# DATA_FILE=data.json

# Runtime environment. Set to "production" in deployed environments.
# NODE_ENV=development

# Minimum log level: trace | debug | info | warn | error | fatal | silent
# LOG_LEVEL=info

# Database URL (used by Knex migrations)
# SQLite (development): leave as default or set a file path
# DATABASE_URL=./dev.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Database Connection Pool (Production) ──────────────────────────────────
# Issue #314: Optimized connection pooling for high concurrency
# DATABASE_SSL=false
# DB_POOL_MIN=2
# DB_POOL_MAX=20
# DB_ACQUIRE_TIMEOUT=30000
# DB_CREATE_TIMEOUT=5000
# DB_DESTROY_TIMEOUT=5000
# DB_IDLE_TIMEOUT=60000
# DB_REAP_INTERVAL=1000
# DB_CREATE_RETRY_INTERVAL=100

# ── Redis cache (optional) ────────────────────────────────────────────────────
# When unset the backend falls back to an in-process no-op cache.
# Use rediss:// (note the double-s) as the URL scheme for TLS connections.
#
#   Plain TCP:    redis://localhost:6379
#   TLS:          rediss://localhost:6380
#
# REDIS_URL=redis://localhost:6379

# How long (seconds) cached API responses are kept. Must be a positive integer.
# CACHE_TTL_SECONDS=60

# CDN base URL used when API metadata stores relative image/document paths.
# ASSET_CDN_URL overrides CDN_URL for uploaded asset metadata.
# Example: https://assets-cdn.example.com
# CDN_URL=
# ASSET_CDN_URL=

# ── Optional Sentry (error tracking disabled when unset) ──────────────────────

# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1

# ── Security Headers Configuration ─────────────────────────────────────────────
#
# These environment variables control the security headers sent with every response.
# The defaults are strict and recommended for production. Adjust based on your needs.

# HSTS: HTTP Strict Transport Security
# Forces all future connections to use HTTPS. Max age in seconds.
# HSTS_MAX_AGE=31536000
# HSTS_INCLUDE_SUBDOMAINS=true
# HSTS_PRELOAD=false

# CSP: Content Security Policy
# Enables CSP headers to protect against XSS, injection attacks, and unauthorized content loading.
# CSP_ENABLED=true
# CSP_REPORT_ONLY=false
# CSP_REPORT_URI=/api/v1/security/csp-report

# Frame ancestors: Which origins can embed this app in an iframe
# FRAME_ANCESTORS='self'

# Script sources: Which origins can provide JavaScript
# Default restricts to same-origin + unsafe-inline (for inline scripts)
# SCRIPT_SOURCES='self','unsafe-inline'

# Style sources: Which origins can provide CSS
# STYLE_SOURCES='self','unsafe-inline'

# Font sources: Which origins can provide fonts
# FONT_SOURCES='self'

# Image sources: Which origins can provide images
# IMG_SOURCES='self','data:','https:'

# Connect sources: Which origins can be contacted via fetch/WebSocket/XMLHttpRequest
# CONNECT_SOURCES='self'

# Media sources: Which origins can provide audio/video
# MEDIA_SOURCES='self'

# Referrer-Policy: How much referrer information to leak to other sites
# Recommended: strict-no-referrer (most private)
# Other options: no-referrer, no-referrer-when-downgrade, same-origin, strict-origin, etc.
# REFERRER_POLICY=strict-no-referrer

# X-XSS-Protection: Legacy XSS filter header (mostly obsolete, kept for older browsers)
# XSS_FILTER=true

# DNS Prefetch Control: Allow DNS prefetching for performance
# Set to 'true' to allow prefetching (risks DNS leakage), 'false' to disable
# DNS_PREFETCH_CONTROL=false

# Permissions-Policy: Restrict access to powerful browser features
# PERMISSIONS_POLICY=accelerometer=(),camera=(),geolocation=(),gyroscope=(),magnetometer=(),microphone=(),payment=(),usb=()

# Cross-Origin-Resource-Policy: Control cross-origin resource sharing
# CORP=true
# CORP_POLICY=cross-origin

# Certificate Transparency Report URI (optional - only if you use CT monitoring)
# CT_REPORT_URI=

# ── IPFS / Pinata (required for document uploads) ──────────────────────────

# JWT token from your Pinata account (app.pinata.cloud → API Keys → New Key).
# Grant at minimum: pinFileToIPFS, unpin permissions.
# PINATA_JWT=your-pinata-jwt-here

# IPFS gateway base URL. Defaults to the public Pinata gateway.
# You can use any public gateway, e.g. https://cloudflare-ipfs.com
# PINATA_GATEWAY=https://gateway.pinata.cloud

# ── API Key Management ────────────────────────────────────────────────────────

# Legacy: Previously a single hardcoded admin API key was used (ADMIN_API_KEY).
# This has been replaced by a multi-key system managed via database.
#
# API keys are now created dynamically and managed via:
#   POST   /api/v1/api-keys — create a new key
#   GET    /api/v1/api-keys — list all keys
#   GET    /api/v1/api-keys/:id — get key details
#   GET    /api/v1/api-keys/:id/usage — view usage statistics
#   POST   /api/v1/api-keys/:id/rotate — rotate a key
#   DELETE /api/v1/api-keys/:id — revoke/delete a key
#
# Bootstrap: On first deployment, you must manually create an admin API key.
# This requires direct database access or a bootstrapping script.
# The key is then used in the x-api-key header for subsequent requests.